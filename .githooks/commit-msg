#!/usr/bin/env bash
# SPEC-PLAT-02 R29: Conventional Commits for every commit (squash titles are checked again by pr-policy).
msg=$(head -n1 "$1")
types='feat|fix|docs|refactor|test|build|ci|chore|perf|revert'
if [[ "$msg" =~ ^(Merge|Revert\ \"|fixup!|squash!|amend!) ]]; then exit 0; fi
if [[ ! "$msg" =~ ^($types)(\([a-z0-9-]+\))?!?:\ .{3,} ]]; then
  echo "commit-msg: '$msg'" >&2
  echo "  must be '<type>(<scope>)?: <subject>', type one of: ${types//|/, }  (see CONTRIBUTING.md)" >&2
  exit 1
fi
