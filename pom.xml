<?xml version="1.0" encoding="UTF-8"?>
<!--
  gc-parent (ADR-017): the shared build of every GrowerCare Java repository.
  - Libraries in this repository use it as their parent, and so does every service repository (by version).
  - Versions are CI-friendly: ${revision} defaults to a SNAPSHOT; a release tag vX.Y.Z publishes X.Y.Z
    (flatten-maven-plugin writes the resolved version into the published POMs).
  - Published to GitHub Packages (SPEC-PLAT-06 R74).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.growercare</groupId>
  <artifactId>gc-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>gc-parent: shared build for GrowerCare libraries and services</name>
  <url>https://github.com/manjunathyadavs1998/growercare-platform-libs</url>

  <modules>
    <module>gc-common</module>
    <module>gc-shard-routing</module>
    <module>gc-security</module>
    <module>gc-outbox</module>
    <module>gc-event-contracts</module>
    <module>gc-test-support</module>
    <module>coverage</module>
  </modules>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <aws-sdk.version>2.57.3</aws-sdk.version>
    <json-schema-validator.version>3.0.6</json-schema-validator.version>
    <archunit.version>1.5.1</archunit.version>
    <springdoc.version>3.2.0</springdoc.version>
    <jacoco.version>0.8.16</jacoco.version>
    <flatten.version>1.7.3</flatten.version>
    <jib.version>3.4.6</jib.version>
    <!-- Services set this to their image name; Jib uses it (SPEC-PLAT-06 R79). -->
    <gc.image.registry>ghcr.io/manjunathyadavs1998</gc.image.registry>
  </properties>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages (growercare-platform-libs)</name>
      <url>https://maven.pkg.github.com/manjunathyadavs1998/growercare-platform-libs</url>
    </repository>
  </distributionManagement>

  <dependencyManagement>
    <dependencies>
      <!-- Platform libraries: always the same release as this parent -->
      <dependency><groupId>com.growercare</groupId><artifactId>gc-common</artifactId><version>${revision}</version></dependency>
      <dependency><groupId>com.growercare</groupId><artifactId>gc-shard-routing</artifactId><version>${revision}</version></dependency>
      <dependency><groupId>com.growercare</groupId><artifactId>gc-security</artifactId><version>${revision}</version></dependency>
      <dependency><groupId>com.growercare</groupId><artifactId>gc-outbox</artifactId><version>${revision}</version></dependency>
      <dependency><groupId>com.growercare</groupId><artifactId>gc-event-contracts</artifactId><version>${revision}</version></dependency>
      <dependency><groupId>com.growercare</groupId><artifactId>gc-test-support</artifactId><version>${revision}</version></dependency>
      <!-- Third party (not managed by the Spring Boot BOM) -->
      <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>${archunit.version}</version></dependency>
      <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId><version>${springdoc.version}</version></dependency>
      <dependency><groupId>software.amazon.awssdk</groupId><artifactId>bom</artifactId><version>${aws-sdk.version}</version><type>pom</type><scope>import</scope></dependency>
      <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><version>${json-schema-validator.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <!-- Services: `mvn package jib:dockerBuild` or `jib:build` (CI). Distroless Java 21, non-root (SPEC-PLAT-06 R79). -->
        <plugin>
          <groupId>com.google.cloud.tools</groupId>
          <artifactId>jib-maven-plugin</artifactId>
          <version>${jib.version}</version>
          <configuration>
            <from><image>gcr.io/distroless/java21-debian12:nonroot</image></from>
            <to><image>${gc.image.registry}/${project.artifactId}:${project.version}</image></to>
            <container>
              <user>nonroot</user>
              <jvmFlags>
                <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
                <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
              </jvmFlags>
              <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
            </container>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution><id>flatten</id><phase>process-resources</phase><goals><goal>flatten</goal></goals></execution>
          <execution><id>flatten-clean</id><phase>clean</phase><goals><goal>clean</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <!-- ADR-013: no ORM. Queries are hand-written SQL via JdbcClient. -->
                  <excludes>
                    <exclude>org.hibernate.orm:*</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-data-jpa</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Unit tests: *Test. Integration tests (*IT) run in failsafe. -->
          <excludes><exclude>**/*IT.java</exclude></excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!--
        Coverage per repository (SPEC-PLAT-03 R40, now per repo): unit + integration executions are merged and
        reported to target/site/jacoco-merged/jacoco.xml, which CI's coverage gate reads (>= 80 % lines).
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution><id>prepare-agent</id><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>prepare-agent-it</id><goals><goal>prepare-agent-integration</goal></goals></execution>
          <execution>
            <id>merge</id>
            <phase>verify</phase>
            <goals><goal>merge</goal></goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}</directory>
                  <includes><include>jacoco.exec</include><include>jacoco-it.exec</include></includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report-merged</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
              <outputDirectory>${project.reporting.outputDirectory}/jacoco-merged</outputDirectory>
              <excludes><exclude>**/*Application.class</exclude></excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
