{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growercare.example/contracts/events/case.created.schema.json",
  "title": "case.created",
  "description": "A case was created (SPEC-CASE-02).",
  "x-topic": "case.case.events",
  "x-key": "case id (aggregate_id), as a string",
  "x-compatibility": "BACKWARD",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventType": {
      "const": "case.created"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buCode",
        "caseId",
        "caseType",
        "countryCode",
        "growerId",
        "queueCode",
        "status",
        "territoryId"
      ],
      "properties": {
        "buCode": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,64}$"
        },
        "caseId": {
          "type": "string",
          "pattern": "^[0-9]{1,19}$",
          "description": "64-bit id serialised as a string (convention 2)"
        },
        "caseType": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,64}$"
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "growerId": {
          "type": "string",
          "pattern": "^[0-9]{1,19}$",
          "description": "64-bit id serialised as a string (convention 2)"
        },
        "queueCode": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,64}$"
        },
        "status": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,64}$"
        },
        "territoryId": {
          "type": "string",
          "pattern": "^[0-9]{1,19}$",
          "description": "64-bit id serialised as a string (convention 2)"
        }
      }
    }
  }
}
