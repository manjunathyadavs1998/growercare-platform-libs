{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growercare.example/contracts/events/comment.posted.schema.json",
  "title": "comment.posted",
  "description": "A comment was posted; keyed by caseId so it is ordered with the case's other events (SPEC-CASE-03). No comment text (PII risk).",
  "x-topic": "case.case.events",
  "x-key": "case id (aggregate_id), as a string",
  "x-compatibility": "BACKWARD",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventType": {
      "const": "comment.posted"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorRole",
        "caseId",
        "commentId",
        "visibility"
      ],
      "properties": {
        "authorRole": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,64}$"
        },
        "caseId": {
          "type": "string",
          "pattern": "^[0-9]{1,19}$",
          "description": "64-bit id serialised as a string (convention 2)"
        },
        "commentId": {
          "type": "string",
          "pattern": "^[0-9]{1,19}$",
          "description": "64-bit id serialised as a string (convention 2)"
        },
        "visibility": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "PARTNER"
          ]
        }
      }
    }
  }
}
