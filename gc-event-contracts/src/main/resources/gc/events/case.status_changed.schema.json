{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growercare.example/contracts/events/case.status_changed.schema.json",
  "title": "case.status_changed",
  "description": "Workflow transition (SPEC-CASE-02).",
  "x-topic": "case.case.events",
  "x-key": "case id (aggregate_id), as a string",
  "x-compatibility": "BACKWARD",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventType": {
      "const": "case.status_changed"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "from",
        "to",
        "version"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^[0-9]{1,19}$",
          "description": "64-bit id serialised as a string (convention 2)"
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,64}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,64}$"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
